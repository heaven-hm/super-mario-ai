name: Lua checks

on:
  push:
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install Lua 5.1
        run: sudo apt-get update && sudo apt-get install -y lua5.1
      - name: Run syntax and behavior tests
        run: sh tests/run.sh
      - name: Restrict RAM writes to documented testing aids
        run: |
          count=$(grep -c 'memory\.writebyte(' mario_ai_heaven.lua || true)
          if [ "$count" -ne 4 ]; then
            echo 'Only the three timer digits and lives byte may be written in testing mode.'
            exit 1
          fi
